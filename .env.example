# App Store Connect MCP — environment template
#
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real .env file or your Apple .p8 private key — both are
# already covered by .gitignore, keep it that way.

# The issuer ID from your App Store Connect API keys page (a UUID).
# ASC_ISSUER_ID=

# The Key ID shown next to your generated API key.
# ASC_KEY_ID=

# Absolute path to the downloaded AuthKey_XXXXXXXXXX.p8 file. Use this or
# ASC_PRIVATE_KEY below, not both.
# ASC_PRIVATE_KEY_PATH=/ABS/PATH/to/AuthKey_XXXXXXXXXX.p8

# Optional: the .p8 private key contents inline (PEM), for environments
# where writing a key file to disk isn't possible (e.g. CI secrets).
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional: override the App Store Connect API base URL. Defaults to
# https://api.appstoreconnect.apple.com if unset.
# ASC_BASE_URL=https://api.appstoreconnect.apple.com

# Optional: set to "true" to expose all 1263 generated tools individually
# instead of the 4 token-efficient meta-tools. Off by default.
# ASC_EXPOSE_ALL_TOOLS=false
